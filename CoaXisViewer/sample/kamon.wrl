#VRML V2.0 utf8

Transform {
  translation 0 0 0
  children [
    Shape {
      geometry IndexedLineSet {
        coord Coordinate {
          point [
            # --- outer hexagon (radius ~ 1.0) ---
            1000.0 0.0 0.0,      # 0
            500.0 0.866.0 0.0,    # 1
            -500.0 866.0 0.0,   # 2
            -1000.0 0.0 0.0,     # 3
            -500.0 -866.0 0.0,  # 4
            500.0 -866.0 0.0,   # 5

            # --- inner hexagon (radius ~ 0.6) ---
            600.0 0.0 0.0,      # 6
            300.0 519.6 0.0,   # 7
            -300.0 519.6 0.0,  # 8
            -600.0 0.0 0.0,     # 9
            -300.0 -519.6 0.0, # 10
            300.0 -519.6 0.0,  # 11

            # --- center symbol (tree-like shape) ---
            # vertical spine
            0.0 -400.0 0.0,     # 12 bottom
            0.0 400.0 0.0,      # 13 top

            # lower branches
            -200.0 -200.0 0.0,    # 14 left lower
            200.0 -200.0 0.0,     # 15 right lower

            # upper branches
            -250.0 250.0 0.0,   # 16 left upper
            0.0 300.0 0.0,      # 17 center upper
            250.0 250.0 0.0     # 18 right upper
          ]
        }

        coordIndex [
          # --- outer hexagon loop ---
          0, 1, 2, 3, 4, 5, 0, -1,

          # --- inner hexagon loop ---
          6, 7, 8, 9, 10, 11, 6, -1,

          # --- center vertical spine ---
          12, 13, -1,

          # --- lower branches ---
          12, 14, -1,
          12, 15, -1,

          # --- upper branches ---
          13, 16, -1,
          13, 17, -1,
          13, 18, -1
        ]
      }

      appearance Appearance {
        material Material {
          diffuseColor 0.8 0.9 0.2  # 黄緑っぽい色
        }
      }
    }
  ]
}
