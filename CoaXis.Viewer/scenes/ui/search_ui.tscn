[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/panel/SearchUi.cs" id="1_search"]

[node name="Search" type="PanelContainer"]
custom_minimum_size = Vector2(480, 480)
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("1_search")

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2

[node name="Filters" type="GridContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
columns = 2

[node name="EntityTypeLabel" type="Label" parent="MarginContainer/VBoxContainer/Filters"]
layout_mode = 2
text = "Entity Type:"
vertical_alignment = 1

[node name="EntityType" type="OptionButton" parent="MarginContainer/VBoxContainer/Filters"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Entityの種類を完全一致で絞り込みます。Allは指定なしです"

[node name="EntityNameLabel" type="Label" parent="MarginContainer/VBoxContainer/Filters"]
layout_mode = 2
text = "Entity Name:"
vertical_alignment = 1

[node name="EntityName" type="LineEdit" parent="MarginContainer/VBoxContainer/Filters"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Entity名を大文字・小文字を区別せず部分一致で検索します"
placeholder_text = "Entity name contains"

[node name="PropertyTypeLabel" type="Label" parent="MarginContainer/VBoxContainer/Filters"]
layout_mode = 2
text = "Property Type:"
vertical_alignment = 1

[node name="PropertyType" type="OptionButton" parent="MarginContainer/VBoxContainer/Filters"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "所属Propertyの種類を完全一致で絞り込みます。Property条件は同じPropertyに対して判定します"

[node name="PropertyValueTypeLabel" type="Label" parent="MarginContainer/VBoxContainer/Filters"]
layout_mode = 2
text = "Property Value Type:"
vertical_alignment = 1

[node name="PropertyValueType" type="OptionButton" parent="MarginContainer/VBoxContainer/Filters"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "所属Propertyの値の型を完全一致で絞り込みます。Allは指定なしです"

[node name="PropertyValueLabel" type="Label" parent="MarginContainer/VBoxContainer/Filters"]
layout_mode = 2
text = "Property Value:"
vertical_alignment = 1

[node name="PropertyValue" type="LineEdit" parent="MarginContainer/VBoxContainer/Filters"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "所属Propertyの値を大文字・小文字を区別せず部分一致で検索します"
placeholder_text = "Property value contains"

[node name="EntityResultCount" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Entity | 0"

[node name="Results" type="Tree" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = "CoaXisSearchResultTree"
allow_reselect = true
hide_root = true
hide_folding = true
auto_tooltip = false

[node name="PropertyResultCount" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Property | 0"

[node name="PropertyResults" type="Tree" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
allow_reselect = true
allow_search = false
hide_root = true

[node name="SelectAll" type="Button" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
tooltip_text = "現在の選択を検索結果の全Entityに置き換えます"
text = "Select All"
