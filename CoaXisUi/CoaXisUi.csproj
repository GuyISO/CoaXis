<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>CoaXis.Ui</AssemblyName>
    <RootNamespace>CoaXis.Ui</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Svg" Version="3.4.7" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets\logo\logo.svg" LogicalName="CoaXis.Ui.Assets.Logo.svg" />
    <EmbeddedResource Include="assets\icons\ipc.svg" LogicalName="CoaXis.Ui.Assets.Icons.ipc.svg" />
    <EmbeddedResource Include="assets\icons\development-one.svg" LogicalName="CoaXis.Ui.Assets.Icons.development-one.svg" />
    <EmbeddedResource Include="assets\icons\development-two.svg" LogicalName="CoaXis.Ui.Assets.Icons.development-two.svg" />
    <EmbeddedResource Include="assets\icons\message-info.svg" LogicalName="CoaXis.Ui.Assets.Icons.message-info.svg" />
    <EmbeddedResource Include="assets\icons\message-error.svg" LogicalName="CoaXis.Ui.Assets.Icons.message-error.svg" />
    <EmbeddedResource Include="assets\icons\message-warning.svg" LogicalName="CoaXis.Ui.Assets.Icons.message-warning.svg" />
    <EmbeddedResource Include="assets\icons\message-question.svg" LogicalName="CoaXis.Ui.Assets.Icons.message-question.svg" />
  </ItemGroup>
</Project>
